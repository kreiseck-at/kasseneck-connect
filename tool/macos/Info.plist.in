<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Vorlage der Info.plist von Kasseneck Connect.app. tool/build_macos.sh
	  setzt in die beiden Versionsfelder die Version aus der pubspec.yaml.

	  Im Bluetooth-Dialog und in den Systemeinstellungen zeigt macOS den
	  Ordnernamen des Pakets, nicht CFBundleName; der Text unter
	  NSBluetoothAlwaysUsageDescription steht im Dialog. LSUIElement hält
	  das Paket aus dem Dock.

	  Lokales Netzwerk (seit macOS 15): launchd-Agenten fallen anders als
	  Daemons unter die Freigabe. Der LaunchAgent startet die Hauptbinary
	  dieses Pakets, also gilt diese Info.plist: der Text unter
	  NSLocalNetworkUsageDescription steht im Dialog, die Freigabe unter
	  Systemeinstellungen, Datenschutz und Sicherheit, Lokales Netzwerk.
	  NSBonjourServices nennt die Dienste der Druckersuche
	  (printerServices in lib/src/printers/discovery.dart, ohne .local);
	  test/macos_bundle_test.dart hält beide Listen gleich.
	-->
	<key>CFBundleIdentifier</key>
	<string>at.kasseneck.connect</string>
	<key>CFBundleName</key>
	<string>Kasseneck Connect</string>
	<key>CFBundleDisplayName</key>
	<string>Kasseneck Connect</string>
	<key>CFBundleExecutable</key>
	<string>kasseneck-connect</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kasseneck Connect verbindet die Kasse mit Bluetooth-Druckern wie dem Etikettendrucker.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Kasseneck Connect verbindet die Kasse mit Bondruckern und dem Kartenterminal im lokalen Netzwerk.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_printer._tcp</string>
		<string>_pdl-datastream._tcp</string>
		<string>_epos._tcp</string>
	</array>
</dict>
</plist>
